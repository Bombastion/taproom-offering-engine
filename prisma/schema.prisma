// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  binaryTargets = ["linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brewery {
  id  String  @id @default(uuid())
  name String
  defaultLogo String?
  location String?
  // Whose this is. Everything the admin app shows or changes is limited to its owner.
  ownerId String
  owner User @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}

model ItemContainer {
  id  String  @id @default(uuid())
  containerName String
  displayName String
  order Int?
  // Whose this is. Everything the admin app shows or changes is limited to its owner.
  ownerId String
  owner User @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}

model SaleContainer {
  id  String  @id @default(uuid())
  containerId String
  menuItemId String
  price Float
  // Whose this is. Everything the admin app shows or changes is limited to its owner.
  ownerId String
  owner User @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}

model Item {
  id  String  @id @default(uuid())
  internalName String
  displayName String
  breweryId String?
  style String?
  abv Float?
  description String?
  category String?
  // Whose this is. Everything the admin app shows or changes is limited to its owner.
  ownerId String
  owner User @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}

model Menu {
  id  String  @id @default(uuid())
  internalName String
  displayName String
  logo String?
  // The brewery whose name the print view and menu board leave off. Null shows every brewery's name.
  defaultBreweryId String?
  // Whose this is. Everything the admin app shows or changes is limited to its owner.
  ownerId String
  owner User @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}

model SubMenu {
  id  String  @id @default(uuid())
  internalName String
  displayName String
  menuId String
  order Int?
  // The public views this section is left off of: any of "print", "board" (the menu board) and
  // "widget". Empty shows it everywhere.
  hiddenOn String[] @default([])
  // Whose this is. Everything the admin app shows or changes is limited to its owner.
  ownerId String
  owner User @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}

model MenuItem {
  id  String  @id @default(uuid())
  menuId String
  itemId String
  subMenuId String
  itemLogo String?
  order Int?
  // When the item was placed here, so "most recent placement" has a real answer
  createdAt DateTime @default(now())
  // Inactive items stay on the section (keeping their place and prices) but are left off the
  // published menu views
  active Boolean @default(true)
  // Whose this is. Everything the admin app shows or changes is limited to its owner.
  ownerId String
  owner User @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

model User {
  id  String  @id @default(uuid())
  // Lowercased and trimmed; this is what people sign in with
  email String @unique
  displayName String?
  // "scrypt$..." (see auth/passwords.ts). Null means the account can't sign in.
  passwordHash String?
  role UserRole @default(USER)
  status UserStatus @default(PENDING)
  createdAt DateTime @default(now())
  approvedAt DateTime?
  approvedById String?
  sessions Session[]
  breweries Brewery[]
  containers ItemContainer[]
  saleContainers SaleContainer[]
  items Item[]
  menus Menu[]
  subMenus SubMenu[]
  menuItems MenuItem[]
}

model Session {
  // sha256 of the token in the browser's cookie, so a database leak doesn't expose live sessions
  id  String  @id
  userId String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
