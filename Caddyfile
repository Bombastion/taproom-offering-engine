# Reverse proxy in front of the app. Caddy handles HTTPS automatically (Let's Encrypt) once
# DOMAIN is a real domain pointed at this machine's public IP and ports 80+443 are forwarded
# through the router.
{
	# Browsers don't send a server name (SNI) when you browse to a bare IP address, e.g.
	# https://192.168.1.20 from another device on the local network. Caddy would then look for a
	# certificate matching the IP the connection arrived on, which inside Docker is the
	# container's own internal IP, find none, and drop the connection. This tells it which
	# certificate to use in that case. Set DEFAULT_SNI to the LAN IP listed in DOMAIN when
	# testing from other devices; it has no effect on normal visits by domain name.
	default_sni {$DEFAULT_SNI:localhost}
}

# The routing shared by every site below.
(app) {
	# The admin client app (client/ in this repo) lives at /admin/. It calls the server's JSON
	# API at /api on this same origin, which falls through to the server below.
	handle /admin* {
		reverse_proxy admin-client:80
	}

	# Everything else (public menu routes, /api) is the server
	handle {
		reverse_proxy taproom-offering-engine:3000
	}
}

# Public site: a real domain gets a Let's Encrypt certificate. "localhost" and bare IP addresses
# automatically get a certificate from Caddy's own local CA instead.
{$DOMAIN} {
	import app
}

# Internal-only names (e.g. a DNS entry on your router such as zymos.brew). Let's Encrypt can't
# issue for names that don't end in a real public suffix, and Caddy only falls back to its local CA
# on its own for localhost/IPs, so these must be asked for explicitly. Keep them out of DOMAIN:
# DOMAIN is served with Let's Encrypt, and listing an internal name there makes issuance fail with
# "domain name does not end with a valid public suffix".
# The placeholder default just keeps this block valid when INTERNAL_DOMAIN is unset.
{$INTERNAL_DOMAIN:unused.invalid} {
	tls internal
	import app
}
