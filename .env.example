# Copy this file to .env and fill in real values. .env is gitignored.
# The first admin account, created the first time the server starts with an empty database.
# After that the accounts live in the database and these are ignored, so changing the password
# here won't change an existing account's password. TOE_ADMIN_EMAIL is what you sign in with;
# it defaults to "admin" (or to the older TOE_ADMIN_USERNAME if you still have that set).
TOE_ADMIN_EMAIL=admin@example.com
TOE_ADMIN_PASSWORD=change-me-to-something-long-and-random

# People can request accounts from the sign-in screen, and an admin approves them. Set this to
# false to stop accepting new requests (existing accounts, and requests already waiting, are
# unaffected). Takes effect on restart.
# TOE_SIGNUP_ENABLED=false

# Your real domain once it's ready, pointed at this machine's public IP (e.g.
# menu.zymosbrewing.com). Leave unset / "localhost" for local testing.
DOMAIN=localhost, 192.168.12.196

# To test from phones or other computers on your local network, add this machine's LAN IP to
# DOMAIN and set it as DEFAULT_SNI, then browse to https://<that IP>/admin/ (expect a
# certificate warning; Caddy signs local certificates with its own private authority):
# DOMAIN=localhost
# DEFAULT_SNI=192.168.1.20

# A name that only resolves inside your network (e.g. a DNS entry on your router), such as
# zymos.brew. It gets a certificate from Caddy's own local CA. Keep it out of DOMAIN: Let's Encrypt
# can't issue for names without a real public suffix. Browsers must trust Caddy's root certificate
# to avoid warnings (see the README).
# INTERNAL_DOMAIN=zymos.brew

# Host ports Caddy listens on. Change these if something else (another web server on a VPS, say)
# already uses 80 or 443. Browse to https://<domain>:<HTTPS_PORT>/admin/ afterwards.
# HTTP_PORT=8080
# HTTPS_PORT=8443
